/* Neon Noir — generated by build/generate.py; do not edit by hand. */
QTabBar {
    background: #171E26;
    border: 0;
    border-bottom: 1px solid #293037;
    qproperty-drawBase: 0;
}
QTabBar::tab {
    background: #171E26;
    color: #A1A9B0;
    border: 0;
    border-right: 1px solid #293037;
    /* Asymmetric on purpose: the close button is laid out inside the right
       padding, so a symmetric inset leaves it touching the rule between tabs. */
    padding: 6px 18px 6px 14px;
    min-height: 18px;
    margin: 0;
}
QTabBar::tab:selected {
    background: #035C5D;
    color: #D9DFE5;
}
QTabBar::tab:hover:!selected {
    background: #121920;
    color: #D9DFE5;
}
QTabBar::close-button {
    subcontrol-position: right;
    margin-left: 8px;
    margin-right: 8px;
}
